<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/otpRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2">

    <!-- Top Header -->
    <ImageView
        android:id="@+id/topHeaderImage"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:scaleType="fitXY"
        android:src="@drawable/logo_elem"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- OTP Title -->
    <TextView
        android:id="@+id/otpTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/otp_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/topHeaderImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/otpSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/otp_subtitle"
        android:textSize="14sp"
        android:textColor="#555555"
        app:layout_constraintTop_toBottomOf="@id/otpTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- OTP Input Container -->
    <LinearLayout
        android:id="@+id/otpContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/otpSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/otp1"
            android:layout_width="45dp"
            android:layout_height="55dp"
            android:background="@drawable/otp_box_bg"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="20sp"
            android:textColor="#000000"/>

        <EditText
            android:id="@+id/otp2"
            android:layout_width="45dp"
            android:layout_height="55dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/otp_box_bg"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="20sp"
            android:textColor="#000000"/>

        <EditText
            android:id="@+id/otp3"
            android:layout_width="45dp"
            android:layout_height="55dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/otp_box_bg"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="20sp"
            android:textColor="#000000"/>

        <EditText
            android:id="@+id/otp4"
            android:layout_width="45dp"
            android:layout_height="55dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/otp_box_bg"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="20sp"
            android:textColor="#000000"/>

        <EditText
            android:id="@+id/otp5"
            android:layout_width="45dp"
            android:layout_height="55dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/otp_box_bg"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="20sp"
            android:textColor="#000000"/>

        <EditText
            android:id="@+id/otp6"
            android:layout_width="45dp"
            android:layout_height="55dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/otp_box_bg"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="20sp"
            android:textColor="#000000"/>

    </LinearLayout>

    <!-- Verify Button -->
    <Button
        android:id="@+id/verifyButton"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/verify"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:backgroundTint="#D6C4AF"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintTop_toBottomOf="@id/otpContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Resend -->
    <TextView
        android:id="@+id/resendText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/resend_otp_text"
        android:textColor="#555555"
        android:textSize="14sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/verifyButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>